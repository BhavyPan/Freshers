generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  ADMIN
  VOLUNTEER
}

enum EventStatus {
  OPEN
  PAUSED
  CLOSED
}

enum AuditResult {
  GRANTED
  ALREADY_CHECKED_IN
  DENIED
  RATE_LIMITED
  EVENT_CLOSED
  TOKEN_REJECTED
  LOOKUP_FOUND
  LOOKUP_NONE
  UNCHECKED
  EDITED
  DELETED
}

enum CheckInMethod {
  SELF
  DESK
}

// Registered students imported from Excel/CSV (the verification database)
model Student {
  id         String    @id @default(cuid())
  studentId  String    @unique // normalized unique key (trimmed + upper-cased)
  name       String
  mobile     String?
  department String?
  email      String?
  year       String?
  extraData  Json? // unmapped registration columns, keyed by source header
  checkedIn  Boolean   @default(false)
  checkinAt  DateTime?
  checkinBy  String? // SELF (QR scan) or admin username for corrections
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  checkIns  CheckIn[]
  auditLogs AuditLog[]

  @@index([checkedIn])
  @@index([department])
}

// Admin / volunteer accounts for the organizer team
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String?
  role         AdminRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions        AdminSession[]
  checkIns        CheckIn[] @relation("CheckInActor")
  reversedEntries CheckIn[] @relation("CheckInReverser")
}

// Server-side sessions (token stored in httpOnly cookie)
model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// Immutable entry history. Student.checkedIn/checkinAt/checkinBy remain the
// fast current-state projection and are updated in the same transaction.
model CheckIn {
  id               String        @id @default(cuid())
  studentId        String?
  studentKey       String
  enteredAt        DateTime      @default(now())
  method           CheckInMethod
  actorUserId      String?
  actorUsername    String?
  revertedAt       DateTime?
  reversedByUserId String?
  reversalReason   String?

  student    Student?   @relation(fields: [studentId], references: [id], onDelete: SetNull)
  actor      AdminUser? @relation("CheckInActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  reversedBy AdminUser? @relation("CheckInReverser", fields: [reversedByUserId], references: [id], onDelete: SetNull)

  @@index([studentId, enteredAt])
  @@index([studentKey, enteredAt])
  @@index([enteredAt])
  @@index([revertedAt])
}

// Every verification attempt (audit trail)
model AuditLog {
  id         String   @id @default(cuid())
  rawInput   String // exactly what the visitor typed
  lookupId   String // normalized id that was searched
  result     AuditResult
  studentId  String? // link to student row when found
  studentKey String? // denormalized studentId key
  actor      String? // username of the desk operator for MANUAL actions (null = self-scan)
  ipHash     String? // hashed IP for abuse tracking (no raw IP stored)
  userAgent  String?
  createdAt  DateTime @default(now())

  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([result])
  @@index([createdAt])
  @@index([actor])
}

// Event settings + QR token (single row)
model EventSettings {
  id                    String      @id @default("primary")
  eventToken            String      @unique @default(cuid())
  eventName             String      @default("OBSIDIAN '26")
  tagline               String      @default("Unfold the Unknown")
  status                EventStatus @default(OPEN)
  requireQrToken        Boolean     @default(false)
  announcement          String?
  announcementExpiresAt DateTime?
  announcementHistory   Json        @default("[]")
  updatedAt             DateTime    @updatedAt
}

// Shared fixed-window counters for Vercel/serverless instances.
model RateLimitBucket {
  keyHash     String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime

  @@id([keyHash, windowStart])
  @@index([expiresAt])
}
