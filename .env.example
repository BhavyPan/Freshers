# Supabase pooled/Supavisor URL used by the running application.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct or session-pooler URL used by Prisma migrations and bootstrap commands.
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Canonical HTTPS origin encoded into venue, kiosk, pass, and status QR codes.
APP_BASE_URL="https://obsidian26.example.com"

# Generate independent values with at least 32 random bytes each.
SESSION_SECRET="replace-with-a-long-random-secret"
IP_HASH_SECRET="replace-with-another-long-random-secret"

# Used only by npm run db:bootstrap; remove these after bootstrapping.
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-at-least-12-characters"
BOOTSTRAP_ADMIN_DISPLAY_NAME="Head Organizer"

# Optional; supply username and password together.
BOOTSTRAP_VOLUNTEER_USERNAME=""
BOOTSTRAP_VOLUNTEER_PASSWORD=""
BOOTSTRAP_VOLUNTEER_DISPLAY_NAME="Entry Desk"
